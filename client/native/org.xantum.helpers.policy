<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Xantum</vendor>
  <action id="org.xantum.network-protection">
    <description>Manage Xantum network protection</description>
    <message>Authenticate to change Xantum DNS, IPv6 and connection protection.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/xantum/network-protection-linux.py</annotate>
  </action>
  <action id="org.xantum.tun">
    <description>Create the Xantum tunnel</description>
    <message>Authenticate to create the Xantum VPN network interface.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/xantum/xtp-tun-helper</annotate>
  </action>
</policyconfig>
