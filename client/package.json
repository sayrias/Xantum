{
  "name": "xantum",
  "version": "1.0.0",
  "description": "Xantum — Self-hosted XTP VPN for Windows and Linux",
  "homepage": "https://github.com/sayrias/Xantum",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"wait-on --timeout 30000 --interval 500 http://localhost:5173 && electron .\"",
    "dev:ui": "vite",
    "build": "vite build && electron-builder --config build/builder-config.cjs",
    "build:linux": "vite build && electron-builder --config build/builder-config.cjs --linux",
    "build:win": "vite build && electron-builder --config build/builder-config.cjs --win",
    "build:all": "vite build && electron-builder --config build/builder-config.cjs --linux --win",
    "build:ui": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "test": "node --test ../tests/*.test.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.xantum.app",
    "productName": "Xantum",
    "copyright": "Xantum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "!electron/helper",
      "!logs/**",
      "!logs",
      "!*.log",
      "!**/.env",
      "!dist-electron/**",
      "shared/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/logo_square.png",
      "description": "Xantum — Self-hosted XTP VPN for Windows and Linux",
      "maintainer": "Xantum <support@xantum.app>",
      "extraResources": [
        {
          "from": "bin/xtp-tun-helper",
          "to": "bin/xtp-tun-helper"
        },
        {
          "from": "native/network-protection-linux.py",
          "to": "helpers/network-protection-linux.py"
        },
        {
          "from": "native/org.xantum.helpers.policy",
          "to": "helpers/org.xantum.helpers.policy"
        }
      ],
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2",
        "libcups2t64 | libcups2",
        "libxkbcommon0",
        "python3",
        "nftables",
        "iproute2",
        "pkexec | policykit-1"
      ],
      "afterInstall": "build/after-install.tpl",
      "afterRemove": "build/after-remove.tpl"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "extraResources": [
        {
          "from": "bin/xtp-tun-helper.exe",
          "to": "bin/xtp-tun-helper.exe"
        },
        {
          "from": "bin/wintun.dll",
          "to": "bin/wintun.dll"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "beforePack": "./build/validate-package.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "com.xantum.app.desktop"
}
