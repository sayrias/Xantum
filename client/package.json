{
  "name": "xantum",
  "version": "1.0.0",
  "description": "Xantum — Kişisel WireGuard VPN Masaüstü Uygulaması",
  "homepage": "https://xantum.app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:ui": "vite",
    "build": "vite build && electron-builder",
    "build:linux": "vite build && electron-builder --linux",
    "build:win": "vite build && electron-builder --win",
    "build:all": "vite build && electron-builder --linux --win",
    "build:ui": "vite build",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "ini": "^4.1.3",
    "node-fetch": "^3.3.2",
    "node-ssh": "^13.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.xantum.app",
    "productName": "Xantum",
    "copyright": "Xantum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "config.json",
      "!electron/helper",
      "!logs/**",
      "!logs",
      "!*.log",
      "!**/.env",
      "!**/node_modules/**",
      "!dist-electron/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "description": "Xantum — Kişisel WireGuard VPN Masaüstü Uygulaması",
      "maintainer": "Xantum <support@xantum.app>"
    },
    "deb": {
      "depends": [
        "wireguard-tools",
        "libnotify4",
        "libxtst6",
        "libnss3"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "sign": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": []
  }
}
